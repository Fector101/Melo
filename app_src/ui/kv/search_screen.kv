#:import dp kivy.metrics.dp
#:import THEME ui.theme

<PlayAllButton>:
    size_hint: None, None
    size: self.minimum_size
    opacity: 0 if self.disabled else 1
    spacing:dp(8)
    padding:[dp(16),dp(7),dp(10),dp(7)]
    canvas.before:
        Color:
            rgba: THEME.TILE_BG
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    Icon:
        kind: "play"
        color: THEME.ACCENT
        size_hint: [None, None]
        size: dp(14), dp(20) # box; height >= painted glyph
        glyph_scale: .6 # 25dp base → ~14dp painted quad
        halign:"center"
        pos_hint: {"center_y": .5}
    Label:
        text: "Play all"
        # bold:True
        color: THEME.ACCENT
        font_size: "14sp"
        pos_hint: {"center_y": .5}
        # halign:"center"
        text_size: self.width, None
        size_hint: None,None
        height: self.texture_size[1]
        # canvas.before:
        #     Color:
        #         rgba: [1,0,1,1]
        #     Rectangle:
        #         pos: self.pos
        #         size: self.size
<SearchScreen>:
    size_hint: [1, 1]
    canvas.before:
        Color:
            rgba: THEME.BG
        Rectangle:
            pos: 0, 0#self.pos causes lag during transitions
            size: self.size

    BoxLayout:
        id: main_container
        orientation: "vertical"
        padding: [0,0,0,0]
        # spacing: dp(10) causes issue for invisible text that display when no reult
# 
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(8)
            padding: dp(8), 0, dp(15), 0
            
            TransportIcon:
                id: back_button
                kind: "back"
                size: dp(44), dp(44)
                glyph_size: dp(22), dp(22)
                on_release: root.go_back()
            BoxLayout:
                padding: dp(14), 0, dp(8), 0
                spacing: dp(10)
                canvas.before:
                    Color:
                        rgba: THEME.TILE_BG
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]
                Icon:
                    kind: "search"
                    color: THEME.FG_DIM
                    size: dp(20), dp(20)
                    pos_hint: {"center_y": .5}
                TextInput:
                    id: search_input
                    hint_text: "Search songs or artists"
                    multiline: False
                    background_normal: ""
                    background_active: ""
                    background_color: 0, 0, 0, 0
                    foreground_color: THEME.FG
                    hint_text_color: THEME.FG_DIM
                    cursor_color: THEME.ACCENT
                    font_size: "16sp"
                    padding: [0, max(0, (self.height - self.line_height) / 2), 0, 0]
                    on_text: root.query = self.text
                TransportIcon:
                    id: clear_button
                    kind: "close"
                    size: dp(36), dp(36)
                    glyph_size: dp(14), dp(14)
                    color: THEME.FG_DIM
                    opacity: 1 if root.query else 0
                    disabled: not root.query
                    on_release: root.clear_query()
                    pos_hint:{"center_y":.5}

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height
            padding: dp(18), dp(10), dp(20), dp(10)
            spacing: dp(10)
            Label:
                id: result_count
                text: root.result_count
                font_size: "14sp"
                color: THEME.FG_DIM
                halign: "left"
                pos_hint: {"center_y":.5}
                size_hint: [None, None]
                size: self.texture_size

            PlayAllButton:
                id: play_all
                pos_hint: {"center_y": .5}
                disabled: not root.has_results
                on_release: root.play_all()

        Label:
            id: empty_label
            text: root.search_status_text
            color: THEME.FG_DIM
            pos_hint:{"center_y":.1}
            size_hint_y:None
            height: 0 if root.has_results else dp(30)
            opacity: 0 if root.has_results else 1
            valign:"center"
            halign:"center"
            pos_hint:{"center_x":.5}

        RecycleView:
            id: results
            viewclass: "SongRow"
            RecycleBoxLayout:
                orientation: "vertical"
                default_size: None, dp(70)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                    

        Widget:
            id: player_slot
            size_hint_y: None
            height: THEME.PLAYER_HEIGHT
