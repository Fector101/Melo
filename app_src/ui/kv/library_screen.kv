#:import dp kivy.metrics.dp
#:import THEME ui.theme

<LibraryScreen>:
    size_hint: [1,1]
    canvas.before:
        Color:
            rgba: THEME.BG
        Rectangle:
            pos: 0,0#self.pos don't set to self.pos it cause lag in transition
            size: self.size

    BoxLayout:
        id: main_container
        orientation: "vertical"
        BoxLayout:
            orientation: "vertical"
            pos_hint: {"top":1}
            size_hint_y: None
            height: self.minimum_height
            padding: dp(15), dp(30), dp(15), dp(10)
            spacing: dp(15)
            Label:
                text: "Your Library"
                bold: True
                font_size: "40sp"
                halign: "left"
                valign: "middle"
                text_size: self.size
            Label:
                id: status
                font_size: "18sp"
                size_hint_y: None
                height: dp(34)
                halign: "left"
                valign: "middle"
                text_size: self.size
                padding: dp(10), 0
                text: root.status_text
        RecycleView:
            id: songs
            viewclass: "SongRow"
            RecycleBoxLayout:
                orientation: "vertical"
                default_size: None, dp(70)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
        Player:
            id: player_bar
    Fab:
        id: fab
        right: root.right - dp(30)
        y: player_bar.top + dp(24)
