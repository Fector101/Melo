#:import dp kivy.metrics.dp
#:import THEME ui.theme

<LibraryScreen>:
    size_hint: [1,1]
    canvas.before:
        Color:
            rgba: THEME.BG
        Rectangle:
            pos: 0,0#self.pos don't set to self.pos it cause lag in transition
            size: self.size

    BoxLayout:
        id: main_container
        orientation: "vertical"
        BoxLayout:
            pos_hint: {"top":1}
            size_hint_y: None
            height: self.minimum_height
            padding: dp(15), dp(30), dp(15), dp(10)
            spacing: dp(15)
            BoxLayout:
                orientation:"vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(15)
                Label:
                    text: "Your Library"
                    bold: True
                    font_size: "35sp"
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: status
                    font_size: "16sp"
                    size_hint_y: None
                    height: dp(34)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    padding: dp(10), 0
                    text: root.status_text or "0 songs added"
            BoxLayout:# search and future settings btn container
                size_hint: [None,None]
                size: self.minimum_size
                pos_hint:{"center_y":.85}
                TransportIcon:
                    kind: "search"
                    size: dp(34), dp(34)
                    glyph_size: dp(24), dp(24)
                    on_release: setattr(root.manager,"current", "search")
                
                # Button:
                #     text:"settings"
                #     size_hint: [None,None]
                #     size: [50,50]
        RecycleView:
            id: songs
            viewclass: "SongRow"
            RecycleBoxLayout:
                orientation: "vertical"
                default_size: None, dp(70)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
        Widget:
            id: player_slot
            size_hint_y: None
            height: THEME.PLAYER_HEIGHT
    Fab:
        id: fab
        right: root.right - dp(30)
        y: player_slot.top + dp(24)
